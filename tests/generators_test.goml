package tests;

use ecosystem::proptest;
use proptest::Strategy;
use std::math;
use std::testing;
use std::utf8;

#[test]
fn shrink_finds_integer_boundary() -> () {
    let generator = testing::expect_ok(proptest::integers(0, 10000), "integers");
    let result = testing::expect_some(
        testing::expect_ok(
            proptest::check(generator, proptest::Config::new(77), |x: isize| x < 10),
            "check",
        ),
        "failure",
    );
    testing::assert_eq(result.minimal, 10);
    testing::assert_eq(
        testing::expect_ok(proptest::replay(generator, result.seed, 64), "replay"),
        result.initial,
    );
    testing::assert(result.report().contains("minimal: 10"));
    let negative = testing::expect_ok(proptest::integers(-10000, 0), "negative");
    let result = testing::expect_some(
        testing::expect_ok(
            proptest::check(negative, proptest::Config::new(77), |x: isize| x > -10),
            "check",
        ),
        "failure",
    );
    testing::assert_eq(result.minimal, -10);
}

#[test]
fn dependent_generators_preserve_relationships_during_shrinking() -> () {
    let lengths = testing::expect_ok(proptest::integers(1, 20), "lengths");
    let generator = lengths.flat_map(
        |count| {
            proptest::just(count).zip(
                proptest::Generator::new(
                    |_, _| {
                        let values: Vec[isize] = Vec::new();
                        for index in 0..count {
                            values.push(index);
                        }
                        Result::Ok(proptest::Sample::leaf(values))
                    },
                ),
            )
        },
    );
    let result = testing::expect_some(
        testing::expect_ok(
            proptest::check(
                generator,
                proptest::Config::new(88),
                |pair: (isize, Vec[isize])| {
                    testing::assert_eq(pair.0, pair.1.len());
                    false
                },
            ),
            "check",
        ),
        "failure",
    );
    testing::assert_eq(result.minimal.0, 1);
    testing::assert_eq(result.minimal.1.len(), 1);
}

#[test]
fn unicode_float_optional_and_selection_generators() -> () {
    let strings = testing::expect_ok(proptest::strings(proptest::characters(), 0, 20), "strings");
    testing::assert_none(
        testing::expect_ok(
            proptest::check(
                strings,
                proptest::Config::new(66),
                |text: string| {
                    utf8::validate(text.to_bytes().as_slice()).is_ok() && text.char_count() <= 20
                },
            ),
            "unicode property",
        ),
    );
    let floats = testing::expect_ok(proptest::finite_floats(-100.0, 100.0), "floats");
    testing::assert_none(
        testing::expect_ok(
            proptest::check(
                floats,
                proptest::Config::new(99),
                |value: f64| math::is_finite(value) && value >= -100.0 && value <= 100.0,
            ),
            "float bounds",
        ),
    );
    let generator = proptest::optional(proptest::just(7));
    let failed = testing::expect_some(
        testing::expect_ok(
            proptest::check(generator, proptest::Config::new(99), |_| false),
            "optional",
        ),
        "failure",
    );
    testing::assert_none(failed.minimal);
    let choices = testing::expect_ok(
        proptest::select(Vec::from_array(["red", "green", "blue"])),
        "selection",
    );
    let failed = testing::expect_some(
        testing::expect_ok(
            proptest::check(choices, proptest::Config::new(99), |_| false),
            "selection",
        ),
        "failure",
    );
    testing::assert_eq(failed.minimal, "red");
    testing::assert_err(proptest::select::[isize](Vec::new()));
    testing::assert_err(proptest::weighted(Vec::from_array([(0, proptest::just(1))])));
}

enum Tree {
    Leaf,
    Branch(Vec[Tree]),
}

fn depth(tree: Tree) -> isize {
    match tree {
        Leaf => 0,
        Branch(children) => {
            let mut deepest = 0;
            for child in children {
                let current = depth(child);
                if current > deepest {
                    deepest = current;
                }
            }
            deepest + 1
        },
    }
}

#[test]
fn recursive_data_and_budget_validation() -> () {
    let generator = testing::expect_ok(
        proptest::recursive(
            proptest::just(Tree::Leaf),
            |child| {
                child.zip(child).map(|pair| Tree::Branch(Vec::from_array([pair.0, pair.1])))
            },
            4,
        ),
        "recursive",
    );
    testing::assert_none(
        testing::expect_ok(
            proptest::check(generator, proptest::Config::new(42), |tree: Tree| depth(tree) <= 4),
            "tree depth",
        ),
    );
    testing::assert_err(proptest::recursive(proptest::just(1), |child| child, 65));
    testing::assert_err(
        proptest::check(
            proptest::just(1),
            proptest::Config { seed: 0, cases: -1, size: 1, max_shrinks: 1 },
            |_| true,
        ),
    );
    testing::assert_err(proptest::replay(proptest::just(1), 0, -1));
}

#[test]
fn full_machine_integer_range() -> () {
    let lower: isize = -9223372036854775807 - 1;
    let upper: isize = 9223372036854775807;
    let generator = testing::expect_ok(proptest::integers(lower, upper), "wide range");
    testing::assert_none(
        testing::expect_ok(
            proptest::check(
                generator,
                proptest::Config::new(42),
                |value: isize| value >= lower && value < upper,
            ),
            "wide range property",
        ),
    );
}

#[test]
fn finite_float_extremes_preserve_generation_and_shrink_bounds() -> () {
    let tiny = float64_from_bits(1);
    let largest = float64_from_bits(0x7fefffffffffffff);
    for (minimum, maximum) in[
        (tiny, tiny),
        (tiny, tiny * 3.0),
        (-tiny * 3.0, -tiny),
        (-tiny, tiny),
        (largest, largest),
        (largest / 2.0, largest),
        (-largest, largest),
        (-largest, -largest / 2.0),
    ] {
        let generator = testing::expect_ok(proptest::finite_floats(minimum, maximum), "bounds");
        for seed in 0..128 {
            let pending = Vec::from_array(
                [testing::expect_ok(generator.generate(seed.to_u64(), 64), "sample")],
            );
            while let Some(sample) = pending.pop() {
                testing::assert(math::is_finite(sample.value));
                testing::assert(sample.value >= minimum && sample.value <= maximum);
                pending.extend(sample.children());
            }
        }
    }
    let negative_zero = float64_from_bits(0x8000000000000000);
    let fixed = testing::expect_ok(proptest::finite_floats(negative_zero, 0.0), "zero");
    testing::assert_eq(
        float64_to_bits(testing::expect_ok(fixed.generate(1, 1), "zero").value),
        0x8000000000000000,
    );
}

#[test]
fn exact_halfway_interpolation_does_not_round_subnormal_singletons_outward() -> () {
    let seed: u64 = 3453682501520545093;
    for bits in[1, 3, 0x8000000000000001, 0x8000000000000003] {
        let value = float64_from_bits(bits);
        let generator = testing::expect_ok(proptest::finite_floats(value, value), "singleton");
        testing::assert_eq(
            testing::expect_ok(proptest::replay(generator, seed, 64), "halfway replay"),
            value,
        );
    }
}
